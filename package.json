    "@angular/platform-server": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/ssr": "^22.1.3",
    "@vercel/analytics": "^2.0.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
